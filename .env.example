# Chrome Screen Analyzer — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Your Anthropic Claude API key
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Model to use (optional, defaults to claude-sonnet-4-6)
# Options: claude-sonnet-4-6, claude-haiku-4-5-20251001, claude-opus-4-6, claude-opus-4-7, claude-opus-4-8, claude-fable-5
CLAUDE_MODEL=claude-sonnet-4-6
