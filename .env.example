# Chrome Screen Analyzer — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Your Anthropic Claude API key
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Model to use (optional, defaults to claude-sonnet-4-6-20260301)
# Options: claude-sonnet-4-6-20260301, claude-haiku-4-5-20251001, claude-opus-4-6-20260301
CLAUDE_MODEL=claude-sonnet-4-6-20260301
