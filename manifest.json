{
  "manifest_version": 3,
  "name": "Chrome Screen Analyzer",
  "version": "1.0.0",
  "description": "AI-powered screen analysis using Claude. Capture and analyze any webpage content for SEO improvement, text/image enhancement, and document analysis.",
  "author": "Eduardo Arana and Soda 🥤",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle the Screen Analyzer panel"
    }
  }
}
